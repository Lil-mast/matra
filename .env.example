# Matra Environment Variables
# CRITICAL: This is an EXAMPLE file. Never commit secrets to git!
# Copy to .env and fill in your values.
# Add .env to .gitignore

# Flask Environment
FLASK_ENV=development
DEBUG=false

# Security (CRITICAL: Generate a new SECRET_KEY for each environment)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_KEY

# Database (SQLite for dev, PostgreSQL for production)
# Development:
DATABASE_URL=sqlite:///matra_dev.db

# Production (uncomment and fill in your credentials):
# DATABASE_URL=postgresql://user:password@db.example.com:5432/matra_prod

# JWT Configuration
JWT_EXPIRATION_HOURS=24
JWT_ALGORITHM=HS256

# SECURITY: Assessment Endpoint
# Set to 'true' in production to require authentication
ASSESS_REQUIRES_AUTH=false

# Rate Limiting (prevent abuse)
# Format: "requests/period" (e.g., 100/hour, 200/day)
RATELIMIT_DEFAULT=200/hour

# Database Encryption (GDPR compliance)
ENCRYPT_DATABASE=false

# Audit Logging (accountability)
AUDIT_LOG_ENABLED=true

# Data Retention (healthcare requirement: typically 7 years)
DATA_RETENTION_DAYS=2555

# CORS Origins (restrict to known domains in production)
# Comma-separated list of allowed origins
CORS_ORIGINS=*

# Redis (optional, for rate limiting and caching)
# If not set, uses in-memory storage (not recommended for production)
# REDIS_URL=redis://localhost:6379

# Application Logging
LOG_LEVEL=INFO

# Email Configuration (for alerts and notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ADMIN_EMAIL=admin@matra.health

# Sentry (error tracking, optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Production Security Settings (CRITICAL for healthcare)
# ENABLE_HTTPS=true
# SECURE_COOKIES=true
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Strict
